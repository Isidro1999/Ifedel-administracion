    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill:receivables": "tsx prisma/backfill-receivables-to-ars.ts",
    "db:migrate:sqlite-products": "tsx prisma/migrate-sqlite-products-to-postgres.ts",
    "test:exchange-rate": "tsx --test lib/exchange-rate/parse-bna-exchange-rate.test.ts",
    "test:catalog-price": "tsx --test lib/catalog-public-price.test.ts",
    "test:inquiry-totals": "tsx --test lib/catalog-inquiry-totals.test.ts lib/catalog-inquiry-schemas.test.ts lib/tax-id.test.ts",
    "verify:bna-exchange-rate": "tsx scripts/verify-bna-exchange-rate.ts",
