// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  sku           String   @unique
  title         String
  short         String?
  description   String?
  cost          Float?
  costCurrency  String?  @default("USD")
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brandId    Int
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  images ProductImage[]
  specs  ProductSpec[]
  prices ProductPrice[]
  files  ProductFile[]

  @@map("products")
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  url        String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  publicId   String?  @unique

  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductSpec {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specs")
}

model ProductPrice {
  id         Int       @id @default(autoincrement())
  priceList  String
  currency   String    @default("ARS")
  netPrice   Float
  taxRate    Float     @default(0)
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  productId Int
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model ProductFile {
  id        Int      @id @default(autoincrement())
  type      String   // "manual", "ficha", "catalogo", etc.
  url       String
  createdAt DateTime @default(now())

  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_files")
}

model Settings {
  id         Int      @id @default(1)
  usdArsRate Float
  updatedAt  DateTime @updatedAt

  @@map("settings")
}

// --- Auth.js (NextAuth v5) + aprobación manual ---
// SQLite no soporta enums; usamos String. Valores: PENDING, APPROVED, REJECTED / USER, ADMIN
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  emailVerified DateTime?
  role          String    @default("USER")   // USER | ADMIN
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedAt    DateTime?
  approvedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedUsers User[] @relation("ApprovedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
