// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  sku           String   @unique
  title         String
  short         String?
  description   String?
  cost          Float?
  costCurrency  String?  @default("USD")
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brandId    Int
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  images ProductImage[]
  specs  ProductSpec[]
  prices ProductPrice[]
  files  ProductFile[]

  // Relaciones con documentos comerciales (trazabilidad)
  quoteItems QuoteItem[]
  saleItems  SaleItem[]

  @@map("products")
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  url        String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  publicId   String?  @unique

  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductSpec {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specs")
}

model ProductPrice {
  id         Int       @id @default(autoincrement())
  priceList  String
  currency   String    @default("ARS")
  netPrice   Float
  taxRate    Float     @default(0)
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  productId Int
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model ProductFile {
  id        Int      @id @default(autoincrement())
  type      String   // "manual", "ficha", "catalogo", etc.
  url       String
  createdAt DateTime @default(now())

  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_files")
}

model Settings {
  id         Int      @id @default(1)
  usdArsRate Float
  updatedAt  DateTime @updatedAt

  @@map("settings")
}

/// Clientes comerciales de IFEDEL
model Customer {
  id        Int      @id @default(autoincrement())
  name      String?
  company   String?
  email     String?
  phone     String?

  // Datos fiscales / ubicación (opcionales, simples)
  vatCondition String?
  province     String?

  isActive Boolean @default(true)

  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  quotes       Quote[]
  sales        Sale[]
  receivables  Receivable[]

  @@map("customers")
}

/// Cotizaciones (cabecera)
model Quote {
  id          Int    @id @default(autoincrement())
  quoteNumber String @unique

  /// Status de negocio esperados:
  /// - DRAFT: borrador en edición
  /// - SAVED: guardada internamente, no enviada
  /// - SENT: enviada al cliente
  /// - APPROVED: aprobada por el cliente
  /// - REJECTED: rechazada / descartada
  /// - EXPIRED: venció la validez
  status String @default("DRAFT")

  // Cliente (FK opcional) + snapshot embebido
  customerId      Int?
  customer        Customer? @relation(fields: [customerId], references: [id])

  customerName    String?
  customerCompany String?
  customerEmail   String?
  customerPhone   String?

  // Tiempos
  issuedAt  DateTime @default(now()) // fecha del documento
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  // Parámetros comerciales
  currency        String  @default("USD")
  exchangeRateARS Float?
  validityDays    Int     @default(7)
  discountPct     Float   @default(0)

  // Totales genéricos (en currency)
  subtotal          Float
  taxAmount         Float
  total             Float
  discountAmount    Float
  totalWithDiscount Float
  totalARS          Float?

  notes String?

  // Trazabilidad
  createdByUserId String?
  createdBy       User? @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])

  // Relación 0..1 con Sale
  sale Sale? @relation("QuoteSale")

  // Líneas
  items QuoteItem[]

  @@map("quotes")
  @@index([customerId])
  @@index([status])
  @@index([createdByUserId])
}

/// Líneas de cotización
model QuoteItem {
  id Int @id @default(autoincrement())

  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // Relación opcional con Product (trazabilidad)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  // Snapshot de producto
  sku         String
  title       String
  description String?
  imageUrl    String?

  // Precios y cantidades en moneda de la Quote
  currency  String @default("USD")
  unitPrice Float  // sin IVA
  taxRate   Float  @default(0)
  qty       Int    @default(1)

  // Totales por ítem (en currency)
  subtotal  Float
  taxAmount Float
  total     Float

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quote_items")
  @@index([quoteId])
  @@index([productId])
}

/// Ventas (cabecera)
model Sale {
  id         Int    @id @default(autoincrement())
  saleNumber String @unique

  /// Status de negocio esperados:
  /// - DRAFT: venta en borrador
  /// - CONFIRMED: venta confirmada
  /// - CANCELLED: anulada (sólo registro histórico)
  status String @default("DRAFT")

  // Relación opcional a la cotización origen
  quoteId Int? @unique
  quote   Quote? @relation("QuoteSale", fields: [quoteId], references: [id])

  // Cliente (FK opcional) + snapshot embebido
  customerId      Int?
  customer        Customer? @relation(fields: [customerId], references: [id])

  customerName    String?
  customerCompany String?
  customerEmail   String?
  customerPhone   String?

  // Tiempos
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Parámetros comerciales
  currency        String  @default("USD")
  exchangeRateARS Float?
  discountPct     Float   @default(0)

  // Totales genéricos (en currency)
  subtotal          Float
  taxAmount         Float
  total             Float
  discountAmount    Float
  totalWithDiscount Float
  totalARS          Float?

  notes String?

  // Trazabilidad
  createdByUserId String?
  createdBy       User? @relation("SaleCreatedBy", fields: [createdByUserId], references: [id])

  // Cuenta por cobrar (0..1 por venta)
  receivable Receivable?

  // Líneas
  items SaleItem[]

  @@map("sales")
  @@index([customerId])
  @@index([quoteId])
  @@index([status])
  @@index([createdByUserId])
}

/// Líneas de venta
model SaleItem {
  id Int @id @default(autoincrement())

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // Relación opcional con Product
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  // Snapshot de producto
  sku         String
  title       String
  description String?
  imageUrl    String?

  // Precios/cantidades en moneda de la venta
  currency  String @default("USD")
  unitPrice Float  // sin IVA
  taxRate   Float  @default(0)
  qty       Int    @default(1)

  // Totales por ítem
  subtotal  Float
  taxAmount Float
  total     Float

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sale_items")
  @@index([saleId])
  @@index([productId])
}

/// Cuenta por cobrar asociada a una venta (1:1). Base para cobros parciales/totales y proyección de ingresos.
/// OVERDUE no se persiste: se calcula en consultas cuando dueDate < hoy y status es PENDING o PARTIAL.
model Receivable {
  id     Int @id @default(autoincrement())
  saleId Int @unique
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  // Cliente: FK + snapshot mínimo para legibilidad histórica y reporting
  customerId      Int?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerName    String?
  customerCompany String?

  // Montos en moneda de la venta
  totalAmount Float
  currency    String  @default("USD")
  amountPaid  Float   @default(0)
  balance    Float   // totalAmount - amountPaid; se mantiene en sync al registrar cobros

  dueDate  DateTime
  issuedAt DateTime @default(now())

  /// Estados esperados (String):
  /// - PENDING: sin cobros (amountPaid == 0)
  /// - PARTIAL: cobro parcial (0 < amountPaid < totalAmount)
  /// - PAID: totalmente cobrada (amountPaid >= totalAmount)
  /// - CANCELLED: anulada (no se esperan más cobros)
  /// OVERDUE se deriva: dueDate < hoy y status in (PENDING, PARTIAL)
  status String @default("PENDING")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments ReceivablePayment[]

  @@map("receivables")
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

/// Cobro aplicado a una cuenta por cobrar. Un registro por cada pago recibido.
model ReceivablePayment {
  id            Int   @id @default(autoincrement())
  receivableId  Int
  receivable    Receivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)

  amount   Float   // Monto cobrado, en la moneda de la Receivable (ARS)
  paidAt   DateTime @default(now())
  reference String?
  notes    String?

  createdByUserId String?
  createdBy       User? @relation("ReceivablePaymentCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@map("receivable_payments")
  @@index([receivableId])
  @@index([paidAt])
  @@index([createdByUserId])
}

// --- Auth.js (NextAuth v5) + aprobación manual ---
// SQLite no soporta enums; usamos String. Valores: PENDING, APPROVED, REJECTED / USER, ADMIN
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  emailVerified DateTime?
  role          String    @default("USER")   // USER | ADMIN
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedAt    DateTime?
  approvedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedUsers User[] @relation("ApprovedBy")

  // Documentos comerciales creados por el usuario
  quotesCreated         Quote[]             @relation("QuoteCreatedBy")
  salesCreated          Sale[]              @relation("SaleCreatedBy")
  receivablePaymentsCreated ReceivablePayment[] @relation("ReceivablePaymentCreatedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
