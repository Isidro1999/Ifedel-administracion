# Copiá este archivo a `.env` y completá los valores. No commitees `.env`.

# =============================================================================
# Database — PostgreSQL (local, staging o producción)
# =============================================================================
# DATABASE_URL: URL con pooler (PgBouncer) para la app en Vercel — limitá conexiones.
# DIRECT_URL: conexión directa al servidor Postgres (sin pooler) — usada por Prisma
# para `migrate dev` / `migrate deploy`. Debe existir en staging y producción.
# En local sin pooler podés repetir la misma URL en ambas variables.
# DATABASE_URL: Transaction pooler Supabase (:6543) con pgbouncer=true.
# Si la password tiene @ # : etc., debe ir URL-encoded (%40, %23, …).
# No dejes una segunda DATABASE_URL=file:./dev.db (pisa la de Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1"
# DIRECT_URL: Session pooler (:5432) o Direct — para migrate deploy
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# =============================================================================
# Auth.js / NextAuth
# =============================================================================
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# LOCAL: debe ser http://localhost:3000
# PRODUCCIÓN (Vercel): https://app.ifedel.com
# Auth.js usa AUTH_URL como baseUrl del OAuth (redirect_uri de Google).
# Si en la misma terminal hiciste `source .vercel/.env.production.local` o
# `vercel pull`, AUTH_URL de producción queda en el shell y PISA este .env
# → el login local termina en app.ifedel.com. Solución: terminal nueva o
#   unset AUTH_URL   (y reiniciar npm run dev).
# En Google Cloud Console agregá también:
#   http://localhost:3000/api/auth/callback/google
AUTH_URL="http://localhost:3000"
# Opcional (Auth.js v4 legacy); v5 prioriza AUTH_URL.
# NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Cliente: logs [AuthGuard] en consola del navegador (diagnóstico bucles login).
# NEXT_PUBLIC_DEBUG_AUTH=1

# Performance: logs [perf] en server (dev ya los imprime). En prod: DEBUG_PERF=1
# DEBUG_PERF=1
# NEXT_PUBLIC_DEBUG_PERF=1

# Las rutas /api/admin/* requieren sesión NextAuth (usuario APPROVED + rol ADMIN).

# =============================================================================
# Cron (Vercel) — tipo de cambio Banco Nación
# =============================================================================
# Secreto para Authorization: Bearer ${CRON_SECRET} en GET /api/cron/exchange-rate.
# Generar un valor aleatorio fuerte, por ejemplo:
#   openssl rand -base64 32
# Configurar el MISMO valor en Vercel → Project → Settings → Environment Variables
# (Production). No commitear el valor real.
# Vercel Cron (Hobby): schedule "0 15 * * *" = 12:00 America/Argentina/Buenos_Aires
# (UTC−3). La ejecución en Hobby puede no ser exacta al minuto dentro de la hora.
CRON_SECRET=

# =============================================================================
# Cloudinary
# =============================================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =============================================================================
# Catálogo público (WhatsApp + URL canónica)
# =============================================================================
# Solo dígitos con código de país, sin + ni espacios. Ej: 5491151435129
NEXT_PUBLIC_IFEDEL_WHATSAPP_NUMBER=""
# URL canónica del catálogo (producción). En local podés omitirla o usar
# http://localhost:3000/catalogo — en Vercel producción:
# NEXT_PUBLIC_CATALOG_URL=https://ifedel.com
NEXT_PUBLIC_CATALOG_URL=""

# =============================================================================
# Google Analytics 4 — solo catálogo público (ifedel.com)
# =============================================================================
# Measurement ID (formato G-…). Solo en Vercel Production del catálogo.
# Si está vacío o ausente, no se carga ningún script (local/previews OK).
# NO configurar en el entorno del backoffice si se puede evitar.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# =============================================================================
# Consultas comerciales — notificaciones email (Brevo)
# =============================================================================
# API key transaccional de Brevo (solo servidor; nunca NEXT_PUBLIC_*).
BREVO_API_KEY=""
# Remitente (email verificado en Brevo). Nombre aparte:
INQUIRY_NOTIFICATION_FROM="info@ifedel.com"
INQUIRY_NOTIFICATION_FROM_NAME="IFEDEL"
# Destinatarios internos separados por coma (se trimean y validan):
INQUIRY_NOTIFICATION_RECIPIENTS="isidroballestrin@gmail.com,jeroanchelerguez@gmail.com"
# Base del backoffice para el CTA del email (sin barra final).
# Fallback: AUTH_URL. En producción Vercel: https://app.ifedel.com
NEXT_PUBLIC_BACKOFFICE_URL="https://app.ifedel.com"
# Reply-To: se usa el email del cliente cuando lo completó (no configurable).
